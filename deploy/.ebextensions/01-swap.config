# A 1 GB swap file, so a small instance (t3.micro has 1 GB of memory) does not freeze when memory
# runs short. Created once; later deployments only make sure it is switched on.
commands:
  01_create_swap:
    command: |
      if [ ! -f /var/swapfile ]; then
        dd if=/dev/zero of=/var/swapfile bs=1M count=1024
        chmod 600 /var/swapfile
        mkswap /var/swapfile
      fi
  02_enable_swap:
    command: swapon -s | grep -q /var/swapfile || swapon /var/swapfile
